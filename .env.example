# Server-side only. Never prefix this variable with NEXT_PUBLIC_.
OPENAI_API_KEY=
# Optional; defaults to gpt-6-astra.
OPENAI_MODEL=gpt-6-astra

# Required in production to enable AI analysis. Create a shared Upstash Redis database.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Temporary server-side preview gate; use a random value with at least 32 characters.
DEPLOYMENT_ACCESS_SECRET=
